# Copy to .env and fill in. .env is gitignored and does NOT travel with the repo —
# on a new machine you must recreate it. See HANDOVER.md §1.2.

# --- Database -------------------------------------------------------------
# Real PostgreSQL (recommended — see HANDOVER.md §4.1):
#   DATABASE_URL="postgresql://postgres:PASSWORD@localhost:5432/pulse"
#
# Or the local dev server: run `npm run db:dev` and paste the URL it prints.
# Its port is assigned per-machine, so it will not match the example below.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pulse"

# Only needed by the `prisma dev` server, which cannot create its own shadow db.
# Omit entirely on a real PostgreSQL.
# SHADOW_DATABASE_URL=""

# --- Redis ----------------------------------------------------------------
# Any Redis-compatible server. Memurai works on Windows without virtualization.
# Required for enrichment and the feed scheduler.
REDIS_URL="redis://localhost:6379"

# --- Secrets --------------------------------------------------------------
# Generate both with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# AES-256-GCM key for provider API keys stored in the database.
# Declared for the future Settings UI; not yet used — keys come from below.
CREDENTIAL_ENC_KEY=""

# --- Enrichment provider keys ---------------------------------------------
# All three have free tiers. The platform works without them, but enrichment
# is skipped for any provider whose key is absent.
#
#   VirusTotal  4 req/min, 500/day   https://www.virustotal.com/gui/my-apikey
#   AbuseIPDB   1,000 checks/day     https://www.abuseipdb.com/account/api
#   OTX         effectively unlimited https://otx.alienvault.com/settings
#
# VirusTotal's quota is the binding constraint on all bulk work — see
# HANDOVER.md §5.4.
VIRUSTOTAL_API_KEY=""
ABUSEIPDB_API_KEY=""
OTX_API_KEY=""

# --- Optional -------------------------------------------------------------
# Overrides the seeded password for the three demo users. Set this for any
# deployment reachable by anyone but you.
# SEED_PASSWORD=""

# Enables the synthetic stub provider. Leave unset in any real environment —
# it fabricates deterministic fake verdicts for offline development only.
# ENABLE_STUB_PROVIDER="1"

NODE_ENV="development"
